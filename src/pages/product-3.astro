---
import Base from '../layouts/Base.astro';
import PricingCard from '../components/PricingCard.astro';
import { PRODUCT3_TIERS } from '../config';

// opciones que el cliente puede activar (on) y si avisan con mención (ping)
const options = [
  { label: 'OPCIÓN 1', on: true, ping: true },
  { label: 'OPCIÓN 2', on: true, ping: true },
  { label: 'OPCIÓN 3', on: true, ping: false },
  { label: 'OPCIÓN 4', on: true, ping: true },
  { label: 'OPCIÓN 5', on: true, ping: false },
  { label: 'OPCIÓN 6', on: false, ping: false },
  { label: 'OPCIÓN 7', on: false, ping: false },
];

const alerts = [
  { tag: 'AVISO 1', color: '#F87171', border: '#ED4245', time: 'just now' },
  { tag: 'AVISO 2', color: '#57F287', border: '#57F287', time: '4m ago' },
  { tag: 'AVISO 3', color: '#A78BFA', border: '#A78BFA', time: '19m ago' },
];

const features = [
  {
    title: 'TÍTULO DE TARJETA 1',
    body: 'DESCRIPCIÓN DE TARJETA',
    icon: '<rect x="3" y="5" width="18" height="13" rx="2"></rect><path d="M10 9.5 L15 11.5 L10 13.5 Z" fill="#A78BFA" stroke="none"></path><path d="M8 21 H16"></path>',
  },
  {
    title: 'TÍTULO DE TARJETA 2',
    body: 'DESCRIPCIÓN DE TARJETA',
    icon: '<rect x="2" y="8" width="20" height="9" rx="4.5"></rect><circle cx="8" cy="12.5" r="1.5"></circle><path d="M15.5 11 V14"></path><path d="M14 12.5 H17"></path>',
  },
  {
    title: 'TÍTULO DE TARJETA 3',
    body: 'DESCRIPCIÓN DE TARJETA',
    icon: '<path d="M18 8 A6 6 0 0 0 6 8 C6 15 3 17 3 17 H21 C21 17 18 15 18 8 Z"></path><path d="M13.7 21 a2 2 0 0 1-3.4 0"></path>',
  },
  {
    title: 'TÍTULO DE TARJETA 4',
    body: 'DESCRIPCIÓN DE TARJETA',
    icon: '<path d="M4 5 H20 V17 H12 L7 21 V17 H4 Z"></path><path d="M8 9.5 H16"></path><path d="M8 12.5 H13"></path>',
  },
  {
    title: 'TÍTULO DE TARJETA 5',
    body: 'DESCRIPCIÓN DE TARJETA',
    icon: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7 V12 L15.5 14"></path>',
  },
  {
    title: 'TÍTULO DE TARJETA 6',
    body: 'DESCRIPCIÓN DE TARJETA',
    icon: '<circle cx="5.5" cy="12" r="2.2"></circle><circle cx="18.5" cy="5.5" r="2.2"></circle><circle cx="18.5" cy="18.5" r="2.2"></circle><path d="M7.5 11 L16.5 6.5"></path><path d="M7.5 13 L16.5 17.5"></path>',
  },
];
---

<Base title="PRODUCTO 3 — TÍTULO DE LA PÁGINA" description="DESCRIPCIÓN DE LA PÁGINA" active="product-3">
  <div class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-64 left-1/2 h-[860px] w-[1300px] -translate-x-1/2 bg-[radial-gradient(closest-side,rgba(167,139,250,0.10),rgba(167,139,250,0))]"
    >
    </div>

    <!-- Hero -->
    <section
      class="relative mx-auto grid max-w-[1300px] grid-cols-1 items-center gap-14 px-6 pb-20 pt-12 sm:px-10 lg:grid-cols-2 lg:gap-16 lg:px-16 lg:pt-16"
    >
      <div class="flex flex-col gap-6">
        <span
          class="inline-flex items-center gap-2 self-start rounded-full border border-violet/35 bg-violet/6 px-3.5 py-1.5 font-mono text-xs tracking-[1.5px] text-violet"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-violet"></span>
          ETIQUETA DEL PRODUCTO
        </span>
        <h1 class="font-display text-4xl font-bold leading-[1.08] tracking-[0.5px] sm:text-5xl lg:text-[56px]">
          TÍTULO PRINCIPAL DEL PRODUCTO 3
        </h1>
        <p class="max-w-[540px] text-lg leading-relaxed text-muted">DESCRIPCIÓN DEL PRODUCTO</p>
        <div class="mt-2 flex flex-wrap items-center gap-4">
          <a
            href="#pricing"
            class="flex h-[52px] items-center rounded-xl bg-violet px-7 font-display text-base font-semibold tracking-[0.5px] text-violet-deep shadow-[0_0_32px_rgba(167,139,250,0.35)] transition-shadow hover:shadow-[0_0_48px_rgba(167,139,250,0.5)]"
          >
            BOTÓN PRINCIPAL
          </a>
          <a
            href="#features"
            class="flex h-[52px] items-center rounded-xl border border-white/14 px-6 text-base text-ink transition-colors hover:border-white/35"
          >
            See features
          </a>
        </div>
        <p class="flex items-center gap-2 text-[13.5px] text-dim">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
          NOTA BAJO LOS BOTONES
        </p>
      </div>

      <div class="flex flex-col gap-6">
        <!-- Opciones -->
        <div
          class="flex flex-col overflow-hidden rounded-[18px] border border-white/10 bg-white/4 shadow-[0_24px_64px_rgba(0,0,0,0.45)] backdrop-blur-xl"
        >
          <div class="flex items-center justify-between border-b border-white/8 px-5 py-4">
            <span class="flex items-center gap-2.5">
              <span class="dot-live h-2 w-2 rounded-full bg-violet shadow-[0_0_10px_rgba(167,139,250,0.9)]"></span>
              <span class="font-mono text-[12.5px] tracking-[2px] text-muted">OPTIONS</span>
            </span>
            <span class="font-mono text-[12.5px] text-dim">TEXTO</span>
          </div>
          <ul class="grid grid-cols-1 gap-x-4 px-5 py-2 sm:grid-cols-2">
            {
              options.map((option) => (
                <li class="flex items-center gap-2.5 py-2 text-[13.5px]">
                  {option.on ? (
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#A78BFA" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M20 6 9 17l-5-5" /></svg>
                  ) : (
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#55626F" stroke-width="2.2" stroke-linecap="round" class="shrink-0"><path d="M18 6 6 18" /><path d="M6 6 L18 18" /></svg>
                  )}
                  <span class:list={[option.on ? 'text-soft' : 'text-dim']}>{option.label}</span>
                  {option.ping && (
                    <span class="ml-auto rounded bg-violet/15 px-1.5 py-0.5 font-mono text-[10.5px] text-violet">@ping</span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Avisos de ejemplo -->
        {
          alerts.map((alert) => (
            <div
              class="flex flex-col gap-3 rounded-[18px] border border-white/10 bg-white/4 p-5 shadow-[0_24px_64px_rgba(0,0,0,0.45)] backdrop-blur-xl"
              style={`border-left: 4px solid ${alert.border};`}
            >
              <header class="flex items-center gap-2.5">
                <span class="font-mono text-[13px] font-medium tracking-[0.5px]" style={`color: ${alert.color};`}>
                  {alert.tag}
                </span>
                <span class="ml-auto font-mono text-xs text-dim">{alert.time}</span>
              </header>
              <p class="font-mono text-[12.5px] leading-relaxed text-muted">
                TEXTO DEL AVISO<br />
                CAMPO: VALOR
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Features -->
    <section
      id="features"
      class="relative mx-auto flex max-w-[1300px] scroll-mt-8 flex-col gap-10 border-t border-white/8 px-6 py-20 sm:px-10 lg:px-16"
    >
      <div
        class="pointer-events-none absolute -right-96 top-6 h-[640px] w-[860px] bg-[radial-gradient(closest-side,rgba(167,139,250,0.05),rgba(167,139,250,0))]"
      >
      </div>
      <div class="flex max-w-[640px] flex-col gap-3.5">
        <span class="font-mono text-[13px] tracking-[2.5px] text-violet">ETIQUETA</span>
        <h2 class="font-display text-3xl font-bold leading-[1.15] sm:text-[38px]">TÍTULO DE SECCIÓN</h2>
        <p class="text-[16.5px] leading-relaxed text-muted">TEXTO DE SECCIÓN</p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <article class="flex flex-col gap-3.5 rounded-2xl border border-white/9 bg-white/3 p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-violet/30 hover:bg-white/5">
              <span class="flex h-[42px] w-[42px] items-center justify-center rounded-[11px] border border-violet/30 bg-violet/10">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#A78BFA"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={feature.icon}
                />
              </span>
              <h3 class="font-display text-lg font-semibold">{feature.title}</h3>
              <p class="text-[14.5px] leading-relaxed text-muted">{feature.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="relative mx-auto flex max-w-[1300px] scroll-mt-8 flex-col gap-11 px-6 pb-20 pt-2 sm:px-10 lg:px-16">
      <div
        class="pointer-events-none absolute -top-24 left-1/2 h-[560px] w-[1000px] -translate-x-1/2 bg-[radial-gradient(closest-side,rgba(167,139,250,0.07),rgba(167,139,250,0))]"
      >
      </div>
      <div class="flex flex-col items-center gap-3.5 text-center">
        <span class="font-mono text-[13px] tracking-[2.5px] text-violet">PRICING</span>
        <h2 class="font-display text-3xl font-bold sm:text-[38px]">TÍTULO DE PRECIOS</h2>
        <p class="text-[16.5px] text-muted">TEXTO DE PRECIOS</p>
      </div>
      <div class="grid grid-cols-1 items-stretch gap-6 pt-3 sm:grid-cols-2 lg:grid-cols-3">
        {PRODUCT3_TIERS.map((tier) => <PricingCard tier={tier} accent="violet" />)}
      </div>
    </section>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import TiunCheckout from '../components/TiunCheckout.astro';
import { SITE, PROMO_COMMUNITIES, PROMO_A, PROMO_B, PROMO_C } from '../config';

const highlights = [
  { value: 'DATO 1', label: 'etiqueta 1' },
  { value: 'DATO 2', label: 'etiqueta 2' },
  { value: 'DATO 3', label: 'etiqueta 3' },
];

const optionA = ['CARACTERÍSTICA 1', 'CARACTERÍSTICA 2', 'CARACTERÍSTICA 3', 'CARACTERÍSTICA 4'];

// la opción B se presenta como la básica: dos cosas que incluye y dos que no
const optionB = [
  { text: 'CARACTERÍSTICA 1', included: true },
  { text: 'CARACTERÍSTICA 2', included: true },
  { text: 'CARACTERÍSTICA 3', included: false },
  { text: 'CARACTERÍSTICA 4', included: false },
];

const optionC = [
  'CARACTERÍSTICA 1',
  'CARACTERÍSTICA 2',
  'CARACTERÍSTICA 3',
  'CARACTERÍSTICA 4',
  'CARACTERÍSTICA 5',
  'CARACTERÍSTICA 6',
];

const steps = [
  { number: '01', title: 'PASO 1', body: 'DESCRIPCIÓN DEL PASO' },
  { number: '02', title: 'PASO 2', body: 'DESCRIPCIÓN DEL PASO' },
  { number: '03', title: 'PASO 3', body: 'DESCRIPCIÓN DEL PASO' },
];
---

<Base title="PROMOCIONES — TÍTULO DE LA PÁGINA" description="DESCRIPCIÓN DE LA PÁGINA" standalone>
  <div class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-56 left-1/2 h-[760px] w-[1200px] -translate-x-1/2 bg-[radial-gradient(closest-side,rgba(245,184,75,0.09),rgba(245,184,75,0))]"
    >
    </div>

    <!-- Cabecera propia (esta página no lleva el menú de los productos) -->
    <header class="relative z-10 flex items-center justify-between px-6 py-5 sm:px-10 lg:px-16">
      <a href="/promotions" class="flex items-center gap-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-[9px] border border-amber/45 bg-amber/8">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5B84B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 11 L18 5 V19 L3 13 Z"></path>
            <path d="M7 13.5 V18 a1.5 1.5 0 0 0 3 0 V14.8"></path>
          </svg>
        </span>
        <span class="font-display text-lg font-bold tracking-[3px] text-ink">{SITE.name}</span>
      </a>
      <nav class="flex items-center gap-6">
        <a href="#pricing" class="hidden text-[15px] text-muted transition-colors hover:text-ink md:block">Pricing</a>
        <a
          href="#pricing"
          class="flex h-11 items-center rounded-[10px] bg-amber px-5 font-display text-[15px] font-semibold tracking-[0.5px] text-amber-deep transition-shadow hover:shadow-[0_0_24px_rgba(245,184,75,0.45)]"
        >
          BOTÓN
        </a>
      </nav>
    </header>

    <!-- Hero -->
    <section class="relative mx-auto flex max-w-[1300px] flex-col items-center gap-6 px-6 pb-16 pt-12 text-center sm:px-10 lg:px-16">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-amber/40 bg-amber/7 px-3.5 py-1.5 font-mono text-xs tracking-[1.5px] text-amber"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
        ETIQUETA
      </span>
      <h1 class="max-w-[900px] font-display text-4xl font-bold leading-[1.08] sm:text-5xl lg:text-[54px]">
        TÍTULO PRINCIPAL DE PROMOCIONES
      </h1>
      <p class="max-w-[680px] text-lg leading-relaxed text-muted">DESCRIPCIÓN PRINCIPAL</p>
      <div class="mt-1 flex flex-wrap items-center justify-center gap-3.5">
        {
          highlights.map((item) => (
            <span class="flex items-center gap-2 rounded-full border border-white/12 px-4 py-2 text-sm text-muted">
              <span class="font-display font-semibold text-amber">{item.value}</span> {item.label}
            </span>
          ))
        }
      </div>
    </section>

    <!-- Comunidades -->
    <section class="relative mx-auto flex max-w-[1300px] flex-col gap-8 px-6 pb-16 sm:px-10 lg:px-16">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          PROMO_COMMUNITIES.map((community) => (
            <article
              class:list={[
                'relative flex flex-col gap-3.5 rounded-[18px] border p-7 sm:p-8',
                community.flagship
                  ? 'border-amber/55 bg-amber/5 shadow-[0_0_48px_rgba(245,184,75,0.13)]'
                  : 'border-white/10 bg-white/3',
              ]}
            >
              {community.flagship && (
                <span class="absolute -top-3 left-7 rounded-full bg-amber px-3.5 py-1 font-mono text-[11px] font-medium tracking-[1.5px] text-amber-deep">
                  DESTACADA
                </span>
              )}
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="font-display text-xl font-semibold">{community.name}</h2>
                <span class="font-display text-[26px] font-bold text-amber">{community.members}</span>
              </div>
              <p class="text-[15px] leading-relaxed text-muted">{community.blurb}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Precios -->
    <section id="pricing" class="relative mx-auto flex max-w-[1300px] scroll-mt-8 flex-col gap-10 px-6 pb-20 sm:px-10 lg:px-16">
      <div
        class="pointer-events-none absolute -top-24 left-1/2 h-[560px] w-[1000px] -translate-x-1/2 bg-[radial-gradient(closest-side,rgba(245,184,75,0.07),rgba(245,184,75,0))]"
      >
      </div>
      <div class="flex flex-col items-center gap-3 text-center">
        <span class="font-mono text-[13px] tracking-[2.5px] text-amber">PRICING</span>
        <h2 class="font-display text-3xl font-bold sm:text-[38px]">TÍTULO DE PRECIOS</h2>
        <p class="text-[16.5px] text-muted">TEXTO DE PRECIOS</p>
      </div>

      <div class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-2">
        <!-- Opción A: la destacada -->
        <article
          class="relative flex flex-col gap-6 rounded-[18px] border border-amber/55 bg-amber/5 p-7 shadow-[0_0_48px_rgba(245,184,75,0.15)] sm:p-8"
        >
          <span
            class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-amber px-3.5 py-1 font-mono text-[11px] font-medium tracking-[1.5px] text-amber-deep"
          >
            DESTACADA
          </span>
          <div class="flex flex-col gap-2">
            <h3 class="font-display text-[22px] font-semibold">OPCIÓN A</h3>
            <p class="text-[14.5px] leading-relaxed text-muted">DESCRIPCIÓN DE LA OPCIÓN</p>
          </div>
          <ul class="flex flex-col gap-2.5">
            {
              optionA.map((text) => (
                <li class="flex items-center gap-2.5 text-[14.5px] text-soft">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F5B84B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M20 6 9 17l-5-5"></path></svg>
                  {text}
                </li>
              ))
            }
          </ul>
          <div class="mt-auto flex flex-col gap-3">
            {
              PROMO_A.map((offer) => (
                <div class="flex items-center justify-between gap-4 rounded-xl border border-amber/25 bg-black/20 px-5 py-4">
                  <div class="flex flex-col gap-0.5">
                    <span class="flex items-center gap-2 text-[15px] font-semibold">
                      {offer.label}
                      {offer.deal && (
                        <span class="rounded-full bg-amber/15 px-2 py-0.5 font-mono text-[10.5px] tracking-[1px] text-amber">{offer.deal}</span>
                      )}
                    </span>
                    <span class="text-[12.5px] text-dim">{offer.members}</span>
                  </div>
                  <div class="flex items-center gap-4">
                    <span class="font-display text-2xl font-bold">{offer.price}</span>
                    <button
                      type="button"
                      data-tiun-product={offer.tiunProductId}
                      disabled={!offer.tiunProductId}
                      title={offer.tiunProductId ? undefined : 'Checkout coming soon'}
                      class="flex h-11 items-center rounded-[10px] bg-amber px-5 font-display text-[14px] font-semibold text-amber-deep transition-shadow enabled:hover:shadow-[0_0_24px_rgba(245,184,75,0.45)] disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      Book
                    </button>
                  </div>
                </div>
              ))
            }
          </div>
        </article>

        <!-- Opción B: la básica -->
        <article class="flex flex-col gap-6 rounded-[18px] border border-white/10 bg-white/3 p-7 sm:p-8">
          <div class="flex flex-col gap-2">
            <h3 class="flex items-center gap-3 font-display text-[22px] font-semibold text-muted">
              OPCIÓN B
              <span class="rounded-full border border-white/15 px-2.5 py-0.5 font-mono text-[10.5px] tracking-[1.5px] text-dim">BÁSICA</span>
            </h3>
            <p class="text-[14.5px] leading-relaxed text-dim">DESCRIPCIÓN DE LA OPCIÓN</p>
          </div>
          <ul class="flex flex-col gap-2.5">
            {
              optionB.map((item) => (
                <li class:list={['flex items-center gap-2.5 text-[14.5px]', item.included ? 'text-soft' : 'text-dim']}>
                  {item.included ? (
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8B98A5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M20 6 9 17l-5-5"></path></svg>
                  ) : (
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#55626F" stroke-width="2.2" stroke-linecap="round" class="shrink-0"><path d="M18 6 6 18"></path><path d="M6 6 L18 18"></path></svg>
                  )}
                  {item.text}
                </li>
              ))
            }
          </ul>
          <div class="mt-auto flex flex-col gap-3">
            {
              PROMO_B.map((offer) => (
                <div class="flex items-center justify-between gap-4 rounded-xl border border-white/8 bg-black/20 px-5 py-4">
                  <div class="flex flex-col gap-0.5">
                    <span class="flex items-center gap-2 text-[15px] font-semibold text-soft">
                      {offer.label}
                      {offer.deal && (
                        <span class="rounded-full border border-white/12 px-2 py-0.5 font-mono text-[10.5px] tracking-[1px] text-dim">{offer.deal}</span>
                      )}
                    </span>
                    <span class="text-[12.5px] text-dim">{offer.members}</span>
                  </div>
                  <div class="flex items-center gap-4">
                    <span class="font-display text-2xl font-bold text-soft">{offer.price}</span>
                    <button
                      type="button"
                      data-tiun-product={offer.tiunProductId}
                      disabled={!offer.tiunProductId}
                      title={offer.tiunProductId ? undefined : 'Checkout coming soon'}
                      class="flex h-11 items-center rounded-[10px] border border-white/16 px-5 font-display text-[14px] font-semibold text-ink transition-colors enabled:hover:border-white/35 enabled:hover:bg-white/5 disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      Book
                    </button>
                  </div>
                </div>
              ))
            }
          </div>
        </article>
      </div>

      <!-- Opción C: por meses -->
      <article
        class="relative mt-2 flex flex-col gap-8 rounded-[18px] border border-amber/45 bg-amber/5 p-7 shadow-[0_0_48px_rgba(245,184,75,0.10)] sm:p-9 lg:flex-row lg:items-center lg:gap-12"
      >
        <span
          class="absolute -top-3 left-7 rounded-full bg-amber px-3.5 py-1 font-mono text-[11px] font-medium tracking-[1.5px] text-amber-deep"
        >
          ETIQUETA
        </span>
        <div class="flex flex-1 flex-col gap-5">
          <div class="flex flex-col gap-2">
            <h3 class="font-display text-[22px] font-semibold">OPCIÓN C</h3>
            <p class="text-[14.5px] leading-relaxed text-muted">DESCRIPCIÓN DE LA OPCIÓN</p>
          </div>
          <ul class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
            {
              optionC.map((text) => (
                <li class="flex items-center gap-2.5 text-[14.5px] text-soft">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F5B84B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M20 6 9 17l-5-5"></path></svg>
                  {text}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="flex w-full flex-col gap-3 lg:w-[400px] lg:shrink-0">
          {
            PROMO_C.map((offer) => (
              <div class="flex items-center justify-between gap-4 rounded-xl border border-amber/25 bg-black/20 px-5 py-4">
                <span class="flex items-center gap-2 text-[15px] font-semibold">
                  {offer.label}
                  {offer.deal && (
                    <span class="rounded-full bg-amber/15 px-2 py-0.5 font-mono text-[10.5px] tracking-[1px] text-amber">{offer.deal}</span>
                  )}
                </span>
                <div class="flex items-center gap-4">
                  <span class="font-display text-2xl font-bold">{offer.price}</span>
                  <button
                    type="button"
                    data-tiun-product={offer.tiunProductId}
                    disabled={!offer.tiunProductId}
                    title={offer.tiunProductId ? undefined : 'Checkout coming soon'}
                    class="flex h-11 items-center rounded-[10px] bg-amber px-5 font-display text-[14px] font-semibold text-amber-deep transition-shadow enabled:hover:shadow-[0_0_24px_rgba(245,184,75,0.45)] disabled:cursor-not-allowed disabled:opacity-60"
                  >
                    Book
                  </button>
                </div>
              </div>
            ))
          }
        </div>
      </article>

      <p class="flex items-center justify-center gap-2.5 text-center text-[13.5px] text-dim">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
          <rect x="5" y="11" width="14" height="9" rx="2"></rect>
          <path d="M8 11 V8 a4 4 0 0 1 8 0 v3"></path>
        </svg>
        TEXTO SOBRE EL PAGO
      </p>
    </section>

    <!-- Cómo funciona -->
    <section class="relative mx-auto flex max-w-[1300px] flex-col gap-10 px-6 pb-20 sm:px-10 lg:px-16">
      <div
        class="pointer-events-none absolute -right-96 -top-10 h-[560px] w-[820px] bg-[radial-gradient(closest-side,rgba(245,184,75,0.05),rgba(245,184,75,0))]"
      >
      </div>
      <div class="flex flex-col items-center gap-2.5 text-center">
        <span class="font-mono text-[13px] tracking-[2.5px] text-amber">HOW IT WORKS</span>
        <h2 class="font-display text-[28px] font-bold sm:text-[32px]">TÍTULO DE SECCIÓN</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          steps.map((step) => (
            <article class="flex flex-col gap-3 rounded-2xl border border-white/9 bg-white/3 p-6">
              <span class="font-mono text-[13px] text-amber">{step.number}</span>
              <h3 class="font-display text-[17px] font-semibold">{step.title}</h3>
              <p class="text-[14.5px] leading-relaxed text-muted">{step.body}</p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
  <Footer />
  <TiunCheckout />
</Base>

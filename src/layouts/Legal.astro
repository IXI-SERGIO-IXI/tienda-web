---
import Base from './Base.astro';
import { SITE } from '../config';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Base title={`${title} — ${SITE.name}`}>
  <main class="mx-auto flex max-w-[760px] flex-col gap-6 px-6 py-16 sm:px-10">
    <h1 class="font-display text-4xl font-bold">{title}</h1>
    <div class="flex flex-col gap-4 text-[15.5px] leading-relaxed text-muted">
      <slot />
    </div>
  </main>
</Base>
